# Set these as secret environment variables in the Python API host.
ALLOWED_ORIGINS=https://zara-takion-portfolio.rodzmaciel21.workers.dev
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
CONTACT_FROM=
CONTACT_TO=rm20022101@gmail.com

# Set CONTACT_API_ENV=production on the API host. A shared Redis backend is
# required there so rate limits work across restarts and multiple instances.
CONTACT_API_ENV=production
RATELIMIT_STORAGE_URI=rediss://user:password@redis.example.com:6379/0
# Set only after confirming how many trusted proxy hops your API host uses.
TRUSTED_PROXY_HOPS=1
