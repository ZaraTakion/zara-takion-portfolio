{
  "name": "zara-aqua-workstation",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/copy-public.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run src/",
    "test:ui": "node scripts/ui-smoke.mjs",
    "check": "npm run typecheck && npm run test:unit && npm run build"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright": "1.55.1",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "vitest": "4.1.11"
  }
}
